# Copier en .env.local (non versionné). Sans ces variables, l'app tourne en mode démo hors-ligne.
# Supabase (région UE)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# RevenueCat (clés publiques SDK)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# PostHog (instance UE : https://eu.i.posthog.com)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Sentry
EXPO_PUBLIC_SENTRY_DSN=
# Build Sentry (sourcemaps) — à définir dans les secrets EAS, pas ici
# SENTRY_AUTH_TOKEN=
