{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "APP_VARIANT": "development" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "preview" }
    },
    "beta": {
      "distribution": "store",
      "channel": "beta",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "beta" }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production" }
    }
  },
  "submit": {
    "beta": {
      "ios": { "ascAppId": "REMPLACER_PAR_ID_APP_STORE_CONNECT", "appleTeamId": "REMPLACER_PAR_TEAM_ID" },
      "android": { "track": "internal", "serviceAccountKeyPath": "./secrets/google-play-service-account.json" }
    },
    "production": {
      "ios": { "ascAppId": "REMPLACER_PAR_ID_APP_STORE_CONNECT", "appleTeamId": "REMPLACER_PAR_TEAM_ID" },
      "android": { "track": "production", "serviceAccountKeyPath": "./secrets/google-play-service-account.json" }
    }
  }
}
