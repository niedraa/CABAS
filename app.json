{
  "expo": {
    "name": "Cabas",
    "slug": "cabas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cabas",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F1E7",
    "primaryColor": "#173A2C",
    "description": "Cabas planifie tes repas, compare les prix entre enseignes et prépare tes courses. Tes courses, de A à Z.",
    "ios": {
      "bundleIdentifier": "fr.penra.cabas",
      "supportsTablet": false,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.penra.cabas",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#173A2C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "com.android.vending.BILLING"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#173A2C"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173A2C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#E8A33D"
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "@sentry/react-native/expo",
        {
          "organization": "penra",
          "project": "cabas"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {}
    }
  }
}
