{
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2",
    "@std/assert": "jsr:@std/assert@1"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "lint": {
    "exclude": ["_shared/core/"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 120,
    "singleQuote": true,
    "exclude": ["_shared/core/"]
  },
  "test": {
    "include": ["**/*.test.ts"]
  }
}
