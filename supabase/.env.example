# ════════════════════════════════════════════════════════════════════════════
# Secrets des Edge Functions Cabas — MODÈLE (aucune vraie valeur ici).
#
# Local  : copier en supabase/.env (ignoré par git), puis
#          `supabase functions serve --env-file supabase/.env`
# Distant: `supabase secrets set --env-file supabase/.env`
#
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont injectées
# automatiquement par la plateforme : ne pas les définir.
# ════════════════════════════════════════════════════════════════════════════

# ─── IA (generate-meal-plan) ────────────────────────────────────────────────
# Clé API Claude (console Anthropic). Absente → moteur de règles uniquement.
ANTHROPIC_API_KEY=
# Modèle (défaut : claude-haiku-5-5, le plus rapide pour tenir < 10 s).
ANTHROPIC_MODEL=claude-haiku-5-5
# Facultatif : plafond de jetons de sortie (défaut 1500) et délai de l'appel (défaut 7000 ms).
# ANTHROPIC_MAX_TOKENS=1500
# LLM_TIMEOUT_MS=7000

# ─── Abonnement (revenuecat-webhook) ────────────────────────────────────────
# Valeur EXACTE saisie dans RevenueCat › Integrations › Webhooks › Authorization header.
# Générer : openssl rand -hex 32
REVENUECAT_WEBHOOK_SECRET=
# Identifiant de l'entitlement Premium dans RevenueCat (défaut : premium).
# REVENUECAT_ENTITLEMENT_ID=premium

# ─── Tâches planifiées (collect-prices, send-notifications) ─────────────────
# Secret partagé envoyé par pg_cron dans l'en-tête x-cron-secret.
# Même valeur à stocker dans Vault (cabas_cron_secret) — voir docs/BACKEND.md.
# Générer : openssl rand -hex 32
CRON_SECRET=
# Facultatif : pause entre deux appels Open Prices (ms), âge max d'un relevé (jours).
# OPEN_PRICES_DELAY_MS=1000
# OPEN_PRICES_MAX_AGE_DAYS=60
# COLLECT_TIME_BUDGET_MS=120000
# Heure locale du rappel de commande du vendredi (défaut 10).
# ORDER_REMINDER_HOUR=10

# ─── Notifications push (send-notifications) ────────────────────────────────
# Jeton d'accès Expo (requis si « Enhanced push security » est activé sur le projet Expo).
EXPO_ACCESS_TOKEN=

# ─── Journalisation ─────────────────────────────────────────────────────────
# LOG_LEVEL=info

# ─── Fournisseurs d'authentification (lus par config.toml via env()) ─────────
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
